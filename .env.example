# Пример настроек. Настоящие значения задаются переменными окружения перед запуском, например: export FOLLOW_UP_DAYS=5
# Секретов в проекте нет; если появятся, то  только в .env (он в .gitignore).

# Версия, которую показывает /version
APP_VERSION=0.1.0

# Через сколько дней после отклика напоминать о follow-up
FOLLOW_UP_DAYS=7

# Пороги вердикта /match (процент совпадения навыков):
# не ниже APPLY_NOW_THRESHOLD — "Apply now", не ниже TAILOR_THRESHOLD — "Apply after tailoring", иначе "Maybe"
APPLY_NOW_THRESHOLD=75
TAILOR_THRESHOLD=50
