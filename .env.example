# Пример настроек. Настоящие значения задаются переменными окружения перед запуском,
# например: export FOLLOW_UP_DAYS=5
# Секретов в проекте нет; если появятся — только в .env (он в .gitignore), не здесь.

# Версия, которую показывает /version
APP_VERSION=0.1.0

# Через сколько дней после отклика напоминать о follow-up
FOLLOW_UP_DAYS=7
